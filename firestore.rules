rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verified Administrator: Must have an approved Firestore profile with Admin role.
    // Email address alone is NEVER an authorization boundary.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'ADMIN', 'SUPER_ADMIN'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['APPROVED', 'Active'];
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
             data.role in ['Admin', 'ADMIN', 'SUPER_ADMIN', 'Auditor', 'Viewer', 'USER'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'Active', 'Disabled'];
    }

    // User Profiles Collection
    match /users/{userId} {
      // Direct get: Normal user can read ONLY their own profile; Admin can read any profile
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());

      // Collection list: ONLY verified Admin can list the users collection
      allow list: if isSignedIn() && isAdmin();

      // Create: Normal user registering must start as PENDING with unprivileged role,
      // cannot set user_id, and cannot self-approve. Or Admin can provision accounts.
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == request.auth.uid &&
          incoming().status == 'PENDING' &&
          incoming().role in ['USER', 'Auditor', 'Viewer'] &&
          (!('user_id' in incoming()) || incoming().user_id == null) &&
          (!('approved_by' in incoming()) || incoming().approved_by == null) &&
          (!('approved_at' in incoming()) || incoming().approved_at == null) &&
          (!('rejected_by' in incoming()) || incoming().rejected_by == null) &&
          (!('rejected_at' in incoming()) || incoming().rejected_at == null)
        )
      );

      // Update: Admin can change role/status/approval/userId.
      // Owner can update personal profile fields ONLY (e.g. name, avatar, lastLoginAt).
      // Owner can NEVER update role, status, user_id, approved_by, approved_at, rejected_by, rejected_at, rejection_reason, uid, or email!
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          (!('user_id' in existing()) || incoming().user_id == existing().user_id) &&
          (!('approved_by' in existing()) || incoming().approved_by == existing().approved_by) &&
          (!('approved_at' in existing()) || incoming().approved_at == existing().approved_at) &&
          (!('rejected_by' in existing()) || incoming().rejected_by == existing().rejected_by) &&
          (!('rejected_at' in existing()) || incoming().rejected_at == existing().rejected_at) &&
          (!('rejection_reason' in existing()) || incoming().rejection_reason == existing().rejection_reason)
        )
      );

      // Delete: Only verified Admin
      allow delete: if isAdmin();
    }
  }
}
